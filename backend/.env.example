# API server
FRONTEND_ORIGINS=https://egorfateew-ops.github.io,http://localhost:5500,http://127.0.0.1:5500

# TecAlliance Vehicle Identification Service (VIN -> TecDoc KType/NType)
TECDOC_VIN_BASE_URL=https://vehicle-identification.tecalliance.services
TECDOC_VIN_API_KEY=
TECDOC_VIN_AUTH_HEADER=Authorization
TECDOC_VIN_AUTH_PREFIX=
TECDOC_VIN_COUNTRY=RU

# TecDoc Web Service (KType -> linked articles)
# Use the exact endpoint and request format from your TecAlliance contract.
TECDOC_PROVIDER_ID=\nTECDOC_PARTS_URL=
TECDOC_PARTS_API_KEY=
TECDOC_PARTS_AUTH_HEADER=Authorization
TECDOC_PARTS_AUTH_PREFIX=
TECDOC_PARTS_METHOD=POST
# JSON template supports {ktype}, {country}, {language}, {page}, {per_page}.
# Do not copy an endpoint/payload from the China OneDB documentation for a different regional contract.
TECDOC_PARTS_REQUEST_TEMPLATE=
# Optional JSON mapping from storefront categories to licensed TecDoc product group IDs.
# Example shape only: {"brakes":[123,456],"engine":[789]}
TECDOC_PRODUCT_GROUP_MAP={}

TECDOC_CATALOG_COUNTRY=RU
TECDOC_CATALOG_LANGUAGE=RU
